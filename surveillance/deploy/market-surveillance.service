[Unit]
Description=Market Surveillance read-only collection worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=surveillance
WorkingDirectory=/opt/prediction-market-dashboard
EnvironmentFile=/etc/market-surveillance.env
ExecStart=/opt/market-surveillance-venv/bin/python -m surveillance.cli worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/market-surveillance

[Install]
WantedBy=multi-user.target
